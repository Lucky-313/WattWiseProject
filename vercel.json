{
  "version": 2,
  "builds": [
    {
      "src": "Wattwise/Frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "Wattwise/Backend/app/src/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Wattwise/Backend/app/src/main.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "dest": "Wattwise/Frontend/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "Wattwise/Frontend/index.html"
    }
  ]
}
